---
import { Icon } from '@astrojs/starlight/components';
import { GITHUB_URL, withBase } from '../lib/site';
import { SOURCE_TARBALL_URL, SOURCE_ZIP_URL } from '../lib/releases';
---

<aside class="source-build">
	<div class="source-head">
		<span class="source-icon" aria-hidden="true">
			<Icon name="code-branch" />
		</span>
		<div>
			<h3>Compilar desde el código fuente</h3>
			<p>
				Descarga el repositorio o clónalo con Git. Solo necesitas un toolchain
				estable de Rust; Halo no tiene dependencias externas.
			</p>
		</div>
	</div>

	<div class="source-actions">
		<a class="source-button primary" href={SOURCE_ZIP_URL}>
			<Icon name="download" />
			Descargar ZIP
		</a>
		<a class="source-button" href={SOURCE_TARBALL_URL}>Descargar .tar.gz</a>
	</div>

	<pre><code>{`git clone ${GITHUB_URL}.git
cd halo
cargo build --release`}</code></pre>

	<p class="source-hint">
		El binario queda en <code>target/release/halo</code> (o
		<code>target\release\halo.exe</code> en Windows). Consulta las
		<a href={withBase('/empezando/instalacion/#compilar-desde-fuente')}>
			instrucciones completas
		</a>.
	</p>
</aside>

<style>
	.source-build {
		display: grid;
		gap: 0.85rem;
		margin-block: 1.5rem;
		padding: 1rem;
		border: 1px dashed var(--sl-color-hairline-light);
		border-radius: 0.9rem;
		background:
			linear-gradient(135deg, var(--sl-color-accent-low), transparent 60%),
			var(--sl-color-bg-sidebar);
	}

	.source-head {
		display: flex;
		gap: 0.7rem;
		align-items: flex-start;
	}

	.source-icon {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 0.55rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-accent);
	}

	.source-icon :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	.source-build .source-head h3 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	.source-build .source-head p {
		max-width: 44rem;
		margin: 0.2rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.source-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.source-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-1);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			color 160ms ease;
	}

	.source-button:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}

	.source-button.primary {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	.source-button.primary:hover {
		background: var(--sl-color-accent-high);
		color: var(--sl-color-black);
	}

	.source-button :global(svg) {
		width: 0.9rem;
		height: 0.9rem;
	}

	.source-build pre {
		margin: 0;
		padding: 0.8rem 0.95rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.6rem;
		background: var(--sl-color-bg-inline-code);
		overflow-x: auto;
	}

	.source-build pre code {
		font-family: var(--sl-font-mono);
		font-size: 0.82rem;
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}

	.source-build .source-hint {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.source-build .source-hint a {
		color: var(--sl-color-accent);
		text-decoration: none;
	}

	.source-build .source-hint a:hover {
		text-decoration: underline;
	}
</style>

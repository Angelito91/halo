{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "halo",
	"displayName": "Halo",
	"scopeName": "source.halo",
	"fileTypes": ["halo"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#constants" },
		{ "include": "#builtins" },
		{ "include": "#function-definition" },
		{ "include": "#method-call" },
		{ "include": "#operators" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.halo",
					"match": "//.*$"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.halo",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.halo",
							"match": "\\\\[\"'nrt\\\\]"
						}
					]
				},
				{
					"name": "string.quoted.single.halo",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.halo",
							"match": "\\\\[\"'nrt\\\\]"
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.halo",
					"match": "\\b\\d+\\.\\d+\\b"
				},
				{
					"name": "constant.numeric.integer.halo",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.halo",
					"match": "\\b(?:if|else|while|for|in|return|break|continue)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.halo",
					"match": "\\b(?:true|false)\\b"
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.builtin.halo",
					"match": "\\b(?:print|len|str|int|float|abs|type|range|push|pop|append|first|last|reverse|join|sort|contains|index_of|upper|lower|trim|starts_with|ends_with|replace|substr)\\b"
				}
			]
		},
		"function-definition": {
			"patterns": [
				{
					"match": "^\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.halo" }
					}
				}
			]
		},
		"method-call": {
			"patterns": [
				{
					"match": "\\.\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.method.halo" }
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.word.halo",
					"match": "\\b(?:and|or|not)\\b"
				},
				{
					"name": "keyword.operator.halo",
					"match": "&&|\\|\\||==|!=|<=|>=|[+\\-*/%<>=!]"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.halo",
					"match": "[(){}\\[\\],.:]"
				}
			]
		}
	}
}

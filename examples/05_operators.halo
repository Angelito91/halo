print("              | !=       | 5 != 3        | true")
print("              | <        | 5 < 10        | true")
print("              | >        | 5 > 3         | true")
print("              | <=       | 5 <= 5        | true")
print("              | >=       | 5 >= 3        | true")
print("─────────────────────────────────────────────────")

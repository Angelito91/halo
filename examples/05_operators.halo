print("              | ||       | false || true | true")
print("              | !        | !false        | true")
print("─────────────────────────────────────────────────")
print("String        | +        | 'a' + 'b'     | 'ab'")
print("              | *        | 'ab' * 3      | 'ababab'")
print("")


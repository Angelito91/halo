// Halo Programming Language
// Example 10: Arrays - Collections of Values
//
// This example demonstrates array manipulation and operations.
// Arrays are ordered collections that can hold any type of value.
// Currently (Phase 1): Basic indexing, built-in functions, while-loop iteration
// Future (Phase 2): For loops, slicing, dot notation methods

// ──────────────────────────────────────────────────────────────────────────
// 1. CREATING ARRAYS
// ──────────────────────────────────────────────────────────────────────────

print("=== 1. CREATING ARRAYS ===")
print("")

// Array of numbers
numbers = [1, 2, 3, 4, 5]
print("Numbers: " + str(numbers))

// Array of strings
names = ["Alice", "Bob", "Charlie", "Diana"]
print("Names: " + str(names))

// Array of booleans
flags = [true, false, true, true]
print("Flags: " + str(flags))

// Heterogeneous array (mixed types)
mixed = [1, "hello", 3.14, true]
print("Mixed: " + str(mixed))

// Empty array
empty = []
print("Empty: " + str(empty))

// Nested expressions
computed = [1 + 1, 2 * 3, 10 - 5]
print("Computed: " + str(computed))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 2. ARRAY INDEXING - Accessing Elements
// ──────────────────────────────────────────────────────────────────────────

print("=== 2. ARRAY INDEXING ===")
print("")

arr = [10, 20, 30, 40, 50]
print("Array: " + str(arr))
print("")

// Access by index (0-based)
print("First element (arr[0]): " + str(arr[0]))
print("Second element (arr[1]): " + str(arr[1]))
print("Third element (arr[2]): " + str(arr[2]))
print("Last element (arr[4]): " + str(arr[4]))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 3. ARRAY LENGTH
// ──────────────────────────────────────────────────────────────────────────

print("=== 3. ARRAY LENGTH ===")
print("")

arr1 = [1, 2, 3]
arr2 = ["a", "b", "c", "d"]
arr3 = []

print("Length of [1, 2, 3]: " + str(len(arr1)))
print("Length of ['a', 'b', 'c', 'd']: " + str(len(arr2)))
print("Length of []: " + str(len(arr3)))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 4. BUILT-IN FUNCTIONS: push, pop, append
// ──────────────────────────────────────────────────────────────────────────

print("=== 4. BUILT-IN FUNCTIONS: push, pop, append ===")
print("")

// Push: add element to array
arr = [1, 2, 3]
print("Original: " + str(arr))
arr = push(arr, 4)
print("After push(arr, 4): " + str(arr))
arr = push(arr, 5)
print("After push(arr, 5): " + str(arr))

print("")

// Pop: remove last element
arr = [10, 20, 30, 40, 50]
print("Original: " + str(arr))
last_elem = pop(arr)
print("Popped element: " + str(last_elem))
print("Note: pop() returns element, doesn't modify array in place")

print("")

// Append: combine two arrays
arr1 = [1, 2, 3]
arr2 = [4, 5, 6]
print("Array 1: " + str(arr1))
print("Array 2: " + str(arr2))
combined = append(arr1, arr2)
print("append(arr1, arr2): " + str(combined))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 5. BUILT-IN FUNCTIONS: first, last
// ──────────────────────────────────────────────────────────────────────────

print("=== 5. BUILT-IN FUNCTIONS: first, last ===")
print("")

arr = [100, 200, 300, 400, 500]
print("Array: " + str(arr))
print("first(arr): " + str(first(arr)))
print("last(arr): " + str(last(arr)))

names = ["Alice", "Bob", "Charlie"]
print("Array: " + str(names))
print("first(names): " + str(first(names)))
print("last(names): " + str(last(names)))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 6. BUILT-IN FUNCTIONS: reverse
// ──────────────────────────────────────────────────────────────────────────

print("=== 6. BUILT-IN FUNCTIONS: reverse ===")
print("")

arr = [1, 2, 3, 4, 5]
print("Original: " + str(arr))
reversed = reverse(arr)
print("reversed(arr): " + str(reversed))

words = ["hello", "world", "halo"]
print("Original: " + str(words))
reversed_words = reverse(words)
print("reversed(words): " + str(reversed_words))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 7. BUILT-IN FUNCTIONS: join
// ──────────────────────────────────────────────────────────────────────────

print("=== 7. BUILT-IN FUNCTIONS: join ===")
print("")

// Join with separator
arr = [1, 2, 3, 4, 5]
joined = join(arr, ", ")
print("join([1, 2, 3, 4, 5], ', '): " + joined)

words = ["The", "quick", "brown", "fox"]
sentence = join(words, " ")
print("join(['The', 'quick', 'brown', 'fox'], ' '): " + sentence)

colors = ["red", "green", "blue"]
csv = join(colors, "|")
print("join(['red', 'green', 'blue'], '|'): " + csv)

print("")

// ──────────────────────────────────────────────────────────────────────────
// 8. BUILT-IN FUNCTIONS: contains, index_of
// ──────────────────────────────────────────────────────────────────────────

print("=== 8. BUILT-IN FUNCTIONS: contains, index_of ===")
print("")

arr = [10, 20, 30, 40, 50]
print("Array: " + str(arr))
print("contains(arr, 30): " + str(contains(arr, 30)))
print("contains(arr, 25): " + str(contains(arr, 25)))
print("index_of(arr, 30): " + str(index_of(arr, 30)))
print("index_of(arr, 25): " + str(index_of(arr, 25)))

print("")

names = ["Alice", "Bob", "Charlie", "Diana"]
print("Array: " + str(names))
print("contains(names, 'Bob'): " + str(contains(names, "Bob")))
print("contains(names, 'Eve'): " + str(contains(names, "Eve")))
print("index_of(names, 'Bob'): " + str(index_of(names, "Bob")))
print("index_of(names, 'Diana'): " + str(index_of(names, "Diana")))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 9. BUILT-IN FUNCTIONS: sort
// ──────────────────────────────────────────────────────────────────────────

print("=== 9. BUILT-IN FUNCTIONS: sort ===")
print("")

// Sort numbers
arr = [5, 2, 8, 1, 9, 3]
print("Original: " + str(arr))
sorted_arr = sort(arr)
print("sorted(arr): " + str(sorted_arr))

// Sort strings
words = ["zebra", "apple", "mango", "banana"]
print("Original: " + str(words))
sorted_words = sort(words)
print("sorted(words): " + str(sorted_words))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 10. ITERATING WITH WHILE LOOPS
// ──────────────────────────────────────────────────────────────────────────

print("=== 10. ITERATING WITH WHILE LOOPS ===")
print("")

print("--- Printing all elements ---")
arr = [10, 20, 30, 40, 50]
i = 0
while i < len(arr) {
    print("arr[" + str(i) + "] = " + str(arr[i]))
    i = i + 1
}

print("")
print("--- Processing elements ---")
numbers = [1, 2, 3, 4, 5]
sum_total = 0
i = 0
while i < len(numbers) {
    sum_total = sum_total + numbers[i]
    i = i + 1
}
print("Sum of [1, 2, 3, 4, 5]: " + str(sum_total))

print("")
print("--- Conditional iteration ---")
arr = [5, 2, 8, 1, 9, 3, 7]
print("Numbers greater than 5:")
i = 0
while i < len(arr) {
    if arr[i] > 5 {
        print(arr[i])
    }
    i = i + 1
}

print("")

// ──────────────────────────────────────────────────────────────────────────
// 11. PRACTICAL PROJECT: Calculate Statistics
// ──────────────────────────────────────────────────────────────────────────

print("=== 11. PRACTICAL PROJECT: Calculate Statistics ===")
print("")

calculate_average(arr) {
    if len(arr) == 0 {
        return 0
    }
    sum = 0
    i = 0
    while i < len(arr) {
        sum = sum + arr[i]
        i = i + 1
    }
    return sum / len(arr)
}

find_max(arr) {
    if len(arr) == 0 {
        return 0
    }
    max_val = arr[0]
    i = 1
    while i < len(arr) {
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }
    return max_val
}

find_min(arr) {
    if len(arr) == 0 {
        return 0
    }
    min_val = arr[0]
    i = 1
    while i < len(arr) {
        if arr[i] < min_val {
            min_val = arr[i]
        }
        i = i + 1
    }
    return min_val
}

scores = [85, 92, 78, 95, 88, 91, 87, 89]
print("Scores: " + str(scores))
print("Average: " + str(calculate_average(scores)))
print("Max: " + str(find_max(scores)))
print("Min: " + str(find_min(scores)))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 12. PRACTICAL PROJECT: Search and Filter
// ──────────────────────────────────────────────────────────────────────────

print("=== 12. PRACTICAL PROJECT: Search and Filter ===")
print("")

count_occurrences(arr, target) {
    count = 0
    i = 0
    while i < len(arr) {
        if arr[i] == target {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

find_all_indices(arr, target) {
    indices = []
    i = 0
    while i < len(arr) {
        if arr[i] == target {
            indices = push(indices, i)
        }
        i = i + 1
    }
    return indices
}

// Count occurrences
arr = [1, 2, 3, 2, 4, 2, 5]
target = 2
count = count_occurrences(arr, target)
print("Count of " + str(target) + " in " + str(arr) + ": " + str(count))

// Find all positions
indices = find_all_indices(arr, 2)
print("Positions of " + str(target) + ": " + str(indices))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 13. PRACTICAL PROJECT: Validate Data
// ──────────────────────────────────────────────────────────────────────────

print("=== 13. PRACTICAL PROJECT: Validate Data ===")
print("")

is_all_positive(arr) {
    i = 0
    while i < len(arr) {
        if arr[i] <= 0 {
            return false
        }
        i = i + 1
    }
    return true
}

is_all_unique(arr) {
    i = 0
    while i < len(arr) {
        j = i + 1
        while j < len(arr) {
            if arr[i] == arr[j] {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

// Test positive validation
arr1 = [1, 2, 3, 4, 5]
arr2 = [1, -2, 3, 4, 5]
print("Is [1, 2, 3, 4, 5] all positive? " + str(is_all_positive(arr1)))
print("Is [1, -2, 3, 4, 5] all positive? " + str(is_all_positive(arr2)))

print("")

// Test unique validation
arr3 = [1, 2, 3, 4, 5]
arr4 = [1, 2, 3, 2, 5]
print("Is [1, 2, 3, 4, 5] all unique? " + str(is_all_unique(arr3)))
print("Is [1, 2, 3, 2, 5] all unique? " + str(is_all_unique(arr4)))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 14. PRACTICAL PROJECT: Permutation/Combination
// ──────────────────────────────────────────────────────────────────────────

print("=== 14. PRACTICAL PROJECT: Array Transformations ===")
print("")

// Double all elements
double_array(arr) {
    result = []
    i = 0
    while i < len(arr) {
        result = push(result, arr[i] * 2)
        i = i + 1
    }
    return result
}

// Square all elements
square_array(arr) {
    result = []
    i = 0
    while i < len(arr) {
        result = push(result, arr[i] * arr[i])
        i = i + 1
    }
    return result
}

// Convert to strings
stringify_array(arr) {
    result = []
    i = 0
    while i < len(arr) {
        result = push(result, str(arr[i]))
        i = i + 1
    }
    return result
}

arr = [1, 2, 3, 4, 5]
print("Original: " + str(arr))
print("Doubled: " + str(double_array(arr)))
print("Squared: " + str(square_array(arr)))
print("Stringified: " + str(stringify_array(arr)))

print("")

// ──────────────────────────────────────────────────────────────────────────
// 15. ARRAY PATTERNS
// ──────────────────────────────────────────────────────────────────────────

print("=== 15. ARRAY PATTERNS ===")
print("")

// Build array with loop
print("--- Building arrays ---")
even_numbers = []
i = 0
while i <= 10 {
    if i % 2 == 0 {
        even_numbers = push(even_numbers, i)
    }
    i = i + 1
}
print("Even numbers 0-10: " + str(even_numbers))

// Sum array
print("")
print("--- Sum array ---")
arr = [10, 20, 30, 40, 50]
total = 0
i = 0
while i < len(arr) {
    total = total + arr[i]
    i = i + 1
}
print("Sum of " + str(arr) + ": " + str(total))

// Copy array
print("")
print("--- Copy array ---")
original = [1, 2, 3]
copy = []
i = 0
while i < len(original) {
    copy = push(copy, original[i])
    i = i + 1
}
print("Original: " + str(original))
print("Copy: " + str(copy))

print("")


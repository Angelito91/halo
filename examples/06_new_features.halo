print("✓ Use continue to skip unnecessary work")
print("✓ Avoid nested loops when possible")
print("")
print("Example: Instead of nested loops, use direct calculation:")

sum_squares_direct = 0
i = 1
while i <= 10 {
    sum_squares_direct = sum_squares_direct + i * i
    i = i + 1
}
print("Sum of squares 1-10 = " + str(sum_squares_direct))


// PROJECT 12: SIMPLE QUIZ GAME
// ──────────────────────────────────────────────────────────────────────────

print("")
print("=== PROJECT 12: Quiz Game Results ===")
print("")

check_answer(question_num, user_answer, correct_answer) {
    if user_answer == correct_answer {
        print("Q" + str(question_num) + ": CORRECT!")
        return 1
    } else {
        print("Q" + str(question_num) + ": Wrong. Correct answer was: " + str(correct_answer))
        return 0
    }
}

calculate_score(correct, total) {
    percentage = correct * 100 / total
    return percentage
}

print("Quiz Results:")
score = 0
total_q = 5

score = score + check_answer(1, 5, 5)
score = score + check_answer(2, 10, 15)
score = score + check_answer(3, 20, 20)
score = score + check_answer(4, 15, 20)
score = score + check_answer(5, 30, 30)

final_score = calculate_score(score, total_q)
print("")
print("Final Score: " + str(score) + "/" + str(total_q) + " (" + str(final_score) + "%)")


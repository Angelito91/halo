print("")
print("===========================================")
print("You've mastered FIBONACCI!")
print("===========================================")
print("✓ What the Fibonacci sequence is")
print("✓ Simple recursive approach")
print("✓ Problems with exponential time")
print("✓ Iterative optimization")
print("✓ Time complexity analysis")
print("✓ Real-world applications")
print("")

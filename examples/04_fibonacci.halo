// ──────────────────────────────────────────────────────────────────────────
// 12. LARGER FIBONACCI NUMBERS
// ──────────────────────────────────────────────────────────────────────────

print("--- Large Fibonacci Numbers (using iterative) ---")
print("")

large_fibs = 1
while large_fibs <= 50 {
    if large_fibs % 5 == 0 {
        print("F(" + str(large_fibs) + ") = " + str(fibonacci_iterative(large_fibs)))
    }
    large_fibs = large_fibs + 1
}

